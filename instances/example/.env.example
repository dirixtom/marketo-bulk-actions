# Copy this folder to instances/<name>/ and this file to .env (or .env.local, which overrides .env).
# Marketo Admin > Integration > Munchkin, e.g. 123-ABC-456
MARKETO_MUNCHKIN_ID=123-ABC-456
# Marketo Admin > Integration > LaunchPoint > your API service > View Details
MARKETO_CLIENT_ID=your-client-id
MARKETO_CLIENT_SECRET=your-client-secret
